RewriteEngine On
RewriteCond %{HTTP_HOST} !^www.patnysystems.com$
RewriteRule ^(.*)$ https://www.patnysystems.com/$1 [R=301,L]

RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}

RewriteEngine On
# Redirect index.php to the root URL
RewriteRule ^index\.php$ / [L,R=301]

Redirect 301 /products/patny-perforated-cable-trays-pct /patny-perforated-cable-trays-pct.php
Redirect 301 /lib/zlib/constants /
Redirect 301 /utils/common /
Redirect 301 /zlib/constants /
Redirect 301 /zlib/gzheader /
Redirect 301 /adler32 /
Redirect 301 /cable-trays /
Redirect 301 /utils/strings /
Redirect 301 /trees /
Redirect 301 /zlib/inflate /
Redirect 301 /lib/inflate /
# Redirect 301 https://www.patnysystems.com/ /

RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/sitemap.php /patny-angular-ladder-type-cable-trays.php
RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/1000 /patny-angular-ladder-type-cable-trays.php
RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/z-purlin.php /patny-angular-ladder-type-cable-trays.php
RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/patny-coupler-plates.php /patny-angular-ladder-type-cable-trays.php
RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/about.php /patny-angular-ladder-type-cable-trays.php
RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/c-purlin.php /patny-angular-ladder-type-cable-trays.php
RedirectMatch 301 /patny-angular-ladder-type-cable-trays.php/contact.php /patny-angular-ladder-type-cable-trays.php

# Enable the Rewrite Engine
RewriteEngine On

# Redirect URLs with the 's' query string parameter to the homepage
RewriteCond %{QUERY_STRING} ^s= [NC]
RewriteRule ^$ /? [R=301,L]


ErrorDocument 404 https://www.patnysystems.com/



<IfModule mod_expires.c>
  ExpiresActive On

 # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Others
  ExpiresByType application/pdf "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
